# Copy to .env and fill in. Never commit .env.

# Required only for --provider openai (real mode). Mock mode needs no key.
OPENAI_API_KEY=
# Any model that supports Structured Outputs on the Responses API.
OPENAI_MODEL=gpt-5.5

# Used in the email sign-off.
COMPANY_NAME=Brightlane Home Supplies

# Documents processed at the same time.
BATCH_CONCURRENCY=4
# Hard cap on simultaneous API requests across ALL documents and tasks.
LLM_CONCURRENCY=3

# Per-request timeout, and extra attempts for timeouts / rate limits / 5xx errors.
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3

# Size limits. Larger documents are reported as document_too_large, never truncated.
MAX_FILE_BYTES=10485760
MAX_DOCUMENT_CHARS=60000

LOG_LEVEL=INFO
